# MySQL Database Configuration
# Do not place real passwords here. This file is meant as a template.
# In Kubernetes, these are injected via a Secret.
DATABASE_URL=mysql+pymysql://root:your_db_password_here@mysql:3306/timeline_builder

# JWT Configuration
# Use a strong, random 32-byte hex string in production.
SECRET_KEY=your_super_secret_jwt_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
